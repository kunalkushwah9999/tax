# Operator template: replace hostname and certificate paths, then validate on the target host.
# The Java application remains bound to 127.0.0.1 and is never published directly.
server {
    listen 80;
    server_name YOUR_HOSTNAME;
    return 308 https://YOUR_HOSTNAME$request_uri;
}
server {
    listen 443 ssl;
    server_name YOUR_HOSTNAME;
    ssl_certificate /etc/taxdesk/tls/fullchain.pem;
    ssl_certificate_key /etc/taxdesk/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 65536;
    # Native structural preview has a separate 400,000-byte backend envelope.
    location ~ ^/api/cases/[A-Za-z0-9_-]+/itr-native-preview$ {
        client_max_body_size 400000;
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
